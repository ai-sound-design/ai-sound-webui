# Copy to .env and adjust. Every value has a working default.

# Folder with your Pro Tools sessions; shown in the web UI's session browser (read-only)
SESSIONS_DIR=./sessions

# Port of the web UI
WEBUI_PORT=8030

# Docker network of the ai-services compose project (docker network ls)
SERVICES_NETWORK=ai-sound-services_default

# The services, as the web UI container reaches them. Defaults are the compose
# service names; use host/LAN addresses when the backend runs elsewhere.
#GENERATION_URL=http://generation-gateway:8010
#SEARCH_URL=http://sound-search-api:8002
#SPOTTING_URL=http://spotting-api:8003
#HYBRID_URL=http://hybrid-api:8004
